# ABOUTME: Colang 1.0 input rail refusing restricted topic categories beyond the burrito filter.
# ABOUTME: Blocks medical, legal, financial, and political advice by phrase in $user_message.

define bot refuse restricted topic
  "I can't help with that — I'm BurritBot and I only talk about the menu. Want to hear today's special?"

# One check per category. Menu-adjacent words stay out: "stock" alone would catch
# "is the carnitas in stock", "rash" alone would catch "trash".
define flow topic enforcement input
  $ask = $user_message.lower()
  if "medication" in $ask or "symptom" in $ask or "diagnose" in $ask or "a rash" in $ask or "this rash" in $ask
    bot refuse restricted topic
    stop
  if "should i sue" in $ask or "lawsuit" in $ask or "enforceable" in $ask or "in court" in $ask
    bot refuse restricted topic
    stop
  if "buy this stock" in $ask or "stock market" in $ask or "crypto" in $ask or "invest" in $ask
    bot refuse restricted topic
    stop
  if "vote" in $ask or "president" in $ask or "election" in $ask or "better than party" in $ask
    bot refuse restricted topic
    stop
