# ABOUTME: Colang 1.0 input rail that refuses prompt-injection / jailbreak attempts.
# ABOUTME: Works in tandem with LLM Guard PromptInjection — belt-and-braces.

define bot refuse jailbreak
  "I can't change who I am. I'm BurritBot, and I only answer burrito-related questions."

# Phrases from the presenter-driven attacks: instruction overrides, DAN,
# persona swaps and system prompt extraction.
define flow jailbreak detect input
  $ask = $user_message.lower()
  if "ignore all previous instructions" in $ask or "ignore previous instructions" in $ask or "disregard the rules" in $ask
    bot refuse jailbreak
    stop
  if "you are now dan" in $ask or "do anything now" in $ask or "pretend you are not burritbot" in $ask
    bot refuse jailbreak
    stop
  if "system prompt" in $ask or "from now on respond as" in $ask or "act as a different assistant" in $ask or "roleplay as" in $ask
    bot refuse jailbreak
    stop
