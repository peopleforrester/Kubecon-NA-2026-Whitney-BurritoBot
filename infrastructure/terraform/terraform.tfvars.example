# ABOUTME: Example tfvars — copy to terraform.tfvars and fill in real values.
# ABOUTME: Real tfvars files are gitignored; this example contains no live IDs.

# Required — override with the real project ID before apply.
project_id = "kk-community-projects"

# Required — the delivery slug that labels this cluster's spend, as a GCP
# label value (lowercase, digits, '-', '_'). The runbook passes it with
# `-var delivery=<slug>`. A placeholder that is not a label value fails
# validation, so an unset delivery cannot apply.
delivery = "REPLACE_WITH_DELIVERY_SLUG"

# Optional — defaults are in variables.tf.
region       = "us-west1"
cluster_name = "burritbot"
